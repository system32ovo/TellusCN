{
	"schemaVersion": 1,
	"id": "telluscn",
	"version": "${version}",
	"name": "TellusCN",
	"description": "TellusCN is a Chinese mirror optimized version of Tellus mod. Tellus recreates real-world terrain in Minecraft by generating Earth-scale landscapes from geographic data. This version includes optimized data source access for Chinese users.",
	"authors": [
		"BlackHoleEra-Team",
		"Yucareux (Original Author)"
	],
	"contact": {
		"homepage": "https://github.com/system32ovo/TellusCN",
		"sources": "https://github.com/system32ovo/TellusCN"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/tellus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.yucareux.tellus.Tellus"
		],
		"client": [
			"com.yucareux.tellus.TellusClient"
		]
	},
	"mixins": [
		"tellus.mixins.json",
		{
			"config": "tellus.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"distanthorizons": "*"
	}
}
